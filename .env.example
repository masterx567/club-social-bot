# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
# Stringa casuale, Telegram la rimanda in ogni webhook
TELEGRAM_WEBHOOK_SECRET=
# ID del gruppo (negativo, es. -1001234567890). Più ID separati da virgola (es. anche la chat privata per test)
ALLOWED_CHAT_IDS=
# Chat privata dell'admin con il bot: riceve errori tecnici e link login Canva
ADMIN_CHAT_ID=

# Canva Developer Portal -> app privata
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Template "Template Risultato SS Cormano"
CANVA_TEMPLATE_DESIGN_ID=DAxxxxxxxxx

# URL Vercel del progetto, senza slash finale (es. https://your-app.vercel.app)
BASE_URL=
# Stringa casuale, protegge /api/setup e /api/canva-auth
SETUP_SECRET=

# Upstash: create in automatico dall'integrazione Vercel (KV_REST_API_* o UPSTASH_REDIS_REST_*)
